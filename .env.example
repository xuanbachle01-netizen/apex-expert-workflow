# URL of your locally hosted n8n instance
# Named N8N_BASE_URL, not N8N_HOST: n8n loads this .env when started from this folder, and its own
# N8N_HOST (a bare hostname) then breaks every webhook URL.
N8N_BASE_URL=http://localhost:5692
# Data folder of this n8n (scripts/start-n8n.ps1); default: .n8n-apex-expert-workflow in your home folder
# N8N_USER_FOLDER=

# API key for the n8n REST API.
# Generate one in n8n: Settings -> API -> Create an API key
N8N_API_KEY=

# n8n editor login (used by scripts/build-agent-squad.mjs and build-apex-expert.mjs for the Agents API)
N8N_EMAIL=
N8N_PASSWORD=

# APEX app login for the APEX Expert agent's Page_Check tool (scripts/apex-agent-db.mjs)
APEX_TEST_USER=
APEX_TEST_PASSWORD=

# Database target of the APEX Expert: the saved SQLcl connection (sql /nolog, then
# conn -save <name> -savepwd ...), the APEX workspace assigned to its schema, and that schema.
# The tools read them on every call and the agents ask for them with DB_Target, so a change
# needs no rebuild.
APEX_CONNECTION=
APEX_WORKSPACE=
APEX_SCHEMA=
# Optional: ORDS (else "ordsBaseUrl" in agents/apex-expert/apex-expert.json) and the app URL
# (else <ORDS>/r/<workspace, lower case>/).
# ORDS_BASE_URL=https://host:8080/ords/
# APEX_APP_URL=https://host:8080/ords/r/<workspace>/

# Environment tokens (scripts/lib/env.mjs), filled in when workflows and agents are sent to
# n8n. All optional: the defaults are this checkout's folder, your home folder and the
# running node. Uncomment to override.
# PROJECT_ROOT=C:\path\to\this\folder
# USER_HOME=C:\Users\you
# NODE_EXE=C:\Program Files\nodejs\node.exe
